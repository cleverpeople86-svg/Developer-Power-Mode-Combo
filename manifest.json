{
  "manifest_version": 3,
  "name": "Developer Power Mode Combo",
  "version": "1.0.0",
  "description": "A local typing-combo counter and tiny animated pixel-art pets.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Developer Power Mode Combo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "logic.js",
        "pets.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
